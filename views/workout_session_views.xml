<odoo>
 <record id="view_workout_session_list" model="ir.ui.view"><field name="name">workout.session.list</field><field name="model">workout.session</field><field name="arch" type="xml"><list><field name="reference"/><field name="member_id"/><field name="program_day_id"/><field name="start_datetime"/><field name="duration_minutes"/><field name="total_volume_kg"/><field name="state"/></list></field></record>
 <record id="view_workout_session_form" model="ir.ui.view"><field name="name">workout.session.form</field><field name="model">workout.session</field><field name="arch" type="xml"><form><header><button name="action_start" type="object" string="Start Workout" class="btn-primary" invisible="state != 'planned'"/><button name="action_complete" type="object" string="Complete Workout" class="btn-primary" invisible="state != 'in_progress'"/><field name="state" widget="statusbar"/></header><sheet><div class="oe_title"><h1><field name="name" readonly="1"/></h1></div><group><group><field name="member_id"/><field name="trainer_id" readonly="1"/><field name="program_day_id"/></group><group><field name="start_datetime"/><field name="end_datetime"/><field name="duration_minutes" readonly="1"/><field name="total_volume_kg" readonly="1"/></group></group><notebook><page string="Workout Execution"><field name="session_exercise_ids"><form><sheet><group><field name="exercise_id"/><field name="target_sets"/><field name="target_reps"/><field name="target_weight_kg"/><field name="rest_seconds"/><field name="target_rpe"/></group><field name="set_ids"><list editable="bottom"><field name="sequence"/><field name="reps"/><field name="weight_kg"/><field name="duration_seconds"/><field name="distance_km"/><field name="rpe"/><field name="completed"/><field name="volume_kg" readonly="1"/></list></field></sheet></form><list><field name="sequence" widget="handle"/><field name="exercise_id"/><field name="target_sets"/><field name="target_reps"/><field name="target_weight_kg"/><field name="completed_sets"/></list></field></page><page string="Notes"><field name="notes"/></page></notebook></sheet></form></field></record>
 <record id="action_workout_sessions" model="ir.actions.act_window"><field name="name">Workout Sessions</field><field name="res_model">workout.session</field><field name="view_mode">list,form</field></record>
 <record id="view_workout_attendance_list" model="ir.ui.view"><field name="name">workout.attendance.list</field><field name="model">workout.attendance</field><field name="arch" type="xml"><list><field name="member_id"/><field name="check_in"/><field name="check_out"/><field name="method"/><field name="state"/></list></field></record>
 <record id="action_workout_attendance" model="ir.actions.act_window"><field name="name">Attendance</field><field name="res_model">workout.attendance</field><field name="view_mode">list,form</field></record>
</odoo>
