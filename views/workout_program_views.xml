<odoo>
 <record id="view_workout_program_list" model="ir.ui.view"><field name="name">workout.program.list</field><field name="model">workout.program</field><field name="arch" type="xml"><list><field name="name"/><field name="goal"/><field name="level"/><field name="duration_weeks"/><field name="trainer_id"/><field name="state"/></list></field></record>
 <record id="view_workout_program_form" model="ir.ui.view"><field name="name">workout.program.form</field><field name="model">workout.program</field><field name="arch" type="xml"><form><header><button name="action_publish" type="object" string="Publish" invisible="state != 'draft'"/><button name="action_archive" type="object" string="Archive" invisible="state == 'archived'"/><field name="state" widget="statusbar"/></header><sheet><group><group><field name="name"/><field name="trainer_id"/><field name="member_ids" widget="many2many_tags"/></group><group><field name="goal"/><field name="level"/><field name="duration_weeks"/></group></group><notebook><page string="Schedule"><field name="day_ids"><form><sheet><group><field name="name"/><field name="week_number"/><field name="weekday"/><field name="estimated_minutes"/></group><field name="prescription_ids"><list editable="bottom"><field name="sequence" widget="handle"/><field name="exercise_id"/><field name="prescription_type"/><field name="set_count"/><field name="target_reps"/><field name="target_weight_kg"/><field name="rest_seconds"/><field name="target_rpe"/></list></field></sheet></form><list><field name="week_number"/><field name="weekday"/><field name="name"/><field name="estimated_minutes"/></list></field></page><page string="Notes"><field name="notes"/></page></notebook></sheet></form></field></record>
 <record id="action_workout_programs" model="ir.actions.act_window"><field name="name">Programs</field><field name="res_model">workout.program</field><field name="view_mode">list,form</field></record>
</odoo>
