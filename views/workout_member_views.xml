<odoo>
 <record id="view_workout_member_list" model="ir.ui.view"><field name="name">workout.member.list</field><field name="model">res.partner</field><field name="arch" type="xml"><list><field name="member_reference"/><field name="name"/><field name="phone"/><field name="fitness_level"/><field name="trainer_id"/><field name="current_weight_kg"/><field name="membership_status"/></list></field></record>
 <record id="view_workout_member_form" model="ir.ui.view"><field name="name">workout.member.form</field><field name="model">res.partner</field><field name="arch" type="xml"><form><sheet><div class="oe_title"><h1><field name="name"/></h1><div><field name="member_reference" readonly="1"/></div></div><group><group><field name="is_workout_member"/><field name="date_of_birth"/><field name="gender"/><field name="height_cm"/><field name="fitness_level"/><field name="preferred_workout_time"/></group><group><field name="trainer_id"/><field name="joining_date"/><field name="current_weight_kg" readonly="1"/><field name="body_fat_percent" readonly="1"/><field name="membership_status" readonly="1"/></group></group><notebook><page string="Safety & Preferences"><group><field name="emergency_contact_name"/><field name="emergency_contact_phone"/><field name="dietary_preferences"/><field name="allergy_notes"/><field name="fitness_notes"/></group></page><page string="Goals"><field name="goal_ids"><list editable="bottom"><field name="name"/><field name="goal_type"/><field name="current_value"/><field name="target_value"/><field name="unit"/><field name="progress_percent"/><field name="status"/></list></field></page><page string="Measurements"><field name="measurement_ids"><list editable="bottom"><field name="measurement_date"/><field name="weight_kg"/><field name="body_fat_percent"/><field name="bmi"/><field name="waist_cm"/></list></field></page></notebook></sheet></form></field></record>
 <record id="action_workout_members" model="ir.actions.act_window"><field name="name">Members</field><field name="res_model">res.partner</field><field name="domain">[('is_workout_member', '=', True)]</field><field name="view_mode">list,form</field></record>
</odoo>
